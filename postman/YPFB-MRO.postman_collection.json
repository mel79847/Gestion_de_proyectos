          "name": "Catálogo con SS, ROP y EOQ",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('FIL-ACE-0021: SS 5, ROP 25, EOQ 105', () => { const m = pm.response.json().find(x => x.codigo === 'FIL-ACE-0021'); pm.expect(m.parametros).to.include({ ss: 5, rop: 25, eoq: 105 }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_tecnico}}"
              }
            ],
            "url": "{{api}}/api/maestros/materiales"
          }
        },
        {
          "name": "Duplicado escrito de otra forma: 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('MATERIAL_DUPLICADO', () => pm.expect(pm.response.json().error.codigo).to.eql('MATERIAL_DUPLICADO'));"
                ]
